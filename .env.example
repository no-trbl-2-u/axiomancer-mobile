# Copy this file to .env and fill in the values.
# .env is gitignored; never commit it.

# ============================================================
# DEPLOY GATE — currently a stub (see scripts/deploy-check.mjs)
# ============================================================

# Provider for scripts/deploy-check.mjs. While the gate is a
# stub, leave this unset (or `none`) — the script exits 0.
# When phase 11 (build plan) wires the real EAS Build poll,
# switch to `eas` and fill the EAS_* values below.
#
# Supported once phase 11 lands: eas | none
# DEPLOY_PROVIDER=eas

# --- EAS BUILD (Expo) ----------------------------------------
# Token: https://expo.dev/settings/access-tokens
#   scopes:  builds:read, projects:read
# EXPO_TOKEN=...
#
# Project ID: run `eas project:info` in this repo's root, or
# read it from app.json's `expo.extra.eas.projectId`.
# EAS_PROJECT_ID=...

# ============================================================
# GITHUB — issue triage (skills/triage.md)
# ============================================================

# Repo-scoped PAT used by:
#   - skills/triage.md (inbound user-issue review)
#
# `gh` CLI auto-reads GH_TOKEN.
# Needs: Issues read+write, Metadata read.
# Get one at: https://github.com/settings/tokens
# GH_TOKEN=github_pat_...

# Repo slug for /triage. Defaults to no-trbl-2-u/axiomancer-mobile.
# Override if running the loop against a fork.
# GH_REPO=no-trbl-2-u/axiomancer-mobile

# ============================================================
# CRITIQUE — not applicable for this project
# ============================================================

# Surface = `service` (mobile binary), so `reader` has no live
# URL to walk and CRITIQUE_AUTH_MODE is irrelevant. See
# plan/bearings.md "Auth" and "Surface" sections.
